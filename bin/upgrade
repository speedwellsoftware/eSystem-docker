#!/usr/bin/env bash
# upgrade: install or upgrade to an eSystem build, in one step.
#
#   bin/upgrade <branch> <build URL or file>
#   bin/upgrade v4.9 https://.../v4.9/4.9.12013.tar.gz
#
# Switches this checkout to <branch> (keeping local edits to tracked files),
# then runs that branch's bin/esystem-upgrade with the build, so each version
# installs itself with its own steps. If esystem-upgrade fails before the site
# was touched (download, check or backup), the previous branch is restored.
# Keep this script small and stable: every version runs it to reach the next.
set -euo pipefail

# git rewrites this file when switching branches; run from a copy.
if [ -z "${UPGRADE_COPY:-}" ]; then
    copy="$(mktemp "${TMPDIR:-/tmp}/esystem-upgrade.XXXXXX")"
    cp "$0" "${copy}"
    UPGRADE_COPY="${copy}" UPGRADE_DIR="$(dirname "$(readlink -f "$0")")/.." exec bash "${copy}" "$@"
fi
trap 'rm -f "${UPGRADE_COPY}"' EXIT

[ $# -eq 2 ] || { echo "Usage: $0 <branch, e.g. v4.9> <build URL or file, e.g. .../4.9.12013.tar.gz>" >&2; exit 2; }
BRANCH="$1"
SRC="$2"
[[ "${SRC}" =~ ^https?:// ]] || SRC="$(readlink -f "${SRC}")"
cd "${UPGRADE_DIR}"
[ -f .env ] || { echo "upgrade: no .env in $(pwd): copy .env.example first (README, \"Install\")" >&2; exit 2; }

echo "==> fetch ${BRANCH}"
git fetch --quiet origin
git rev-parse --verify --quiet "origin/${BRANCH}^{commit}" >/dev/null \
    || { echo "upgrade: branch ${BRANCH} not found; available: $(git branch -r --format='%(refname:lstrip=3)' | grep -v '^HEAD$' | tr '\n' ' ')" >&2; exit 2; }

OLD_REF="$(git rev-parse --abbrev-ref HEAD)"
[ "${OLD_REF}" = HEAD ] && OLD_REF="$(git rev-parse HEAD)"

# switch <ref> [<upstream>]: check out <ref> (fast-forwarded to <upstream>),
# carrying local edits across. On a conflict, undo and return non-zero.
switch() {
    local stashed=0
    if ! git diff --quiet HEAD; then
        git stash push --quiet -m "upgrade to $1"
        stashed=1
    fi
    if git checkout --quiet "$1" \
       && { [ -z "${2:-}" ] || git merge --quiet --ff-only "$2"; } \
       && { [ "${stashed}" -eq 0 ] || git stash pop --quiet; }; then
        return 0
    fi
    git reset --quiet --hard
    git checkout --quiet "${OLD_REF}"
    if [ "${stashed}" -eq 1 ]; then git stash pop --quiet; fi
    return 1
}

echo "==> switch to ${BRANCH}"
if ! switch "${BRANCH}" "origin/${BRANCH}"; then
    echo "upgrade: ${BRANCH} changes a file you edited; nothing was changed (README, \"Local changes\")" >&2
    exit 1
fi

rc=0
bin/esystem-upgrade "${SRC}" || rc=$?
if [ "${rc}" -eq 3 ]; then
    echo "==> back to ${OLD_REF}: the site was not changed" >&2
    switch "${OLD_REF}" || echo "upgrade: could not switch back to ${OLD_REF}: check git status" >&2
fi
exit "${rc}"
