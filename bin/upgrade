#!/usr/bin/env bash
# upgrade: install or upgrade to an eSystem build, in one step.
#
#   bin/upgrade <branch> <build URL or file>
#   bin/upgrade v4.9 https://.../v4.9/4.9.12013.tar.gz
#
# Backs up the database with this version's bin/db-backup, switches to
# <branch> (local edits to tracked files are kept; git refuses if the branch
# changes the same file), then runs that branch's bin/esystem-upgrade, so each
# version installs itself with its own steps. If that fails before the site
# was touched (exit 3), the previous version is checked out again.
# Keep this script small and stable: every version runs it to reach the next.
set -euo pipefail

# Everything is inside main, which bash reads whole before running it, because
# git rewrites this file when switching branches.
main() {
    [ $# -eq 2 ] || { echo "Usage: $0 <branch, e.g. v4.9> <build URL or file, e.g. .../4.9.12013.tar.gz>" >&2; exit 2; }
    local branch="$1" src="$2"
    [[ "${src}" =~ ^https?:// ]] || src="$(readlink -f "${src}")"
    cd "$(dirname "$(readlink -f "$0")")/.."
    [ -f .env ] || { echo "upgrade: no .env: copy .env.example first (README, \"Install\")" >&2; exit 2; }

    git fetch --quiet origin
    git rev-parse --verify --quiet "origin/${branch}" >/dev/null || { echo "upgrade: no branch ${branch}" >&2; exit 2; }
    local old old_commit
    old="$(git rev-parse --abbrev-ref HEAD)"
    old_commit="$(git rev-parse HEAD)"

    if [ -d build ]; then
        echo "==> back up the database"
        bin/db-backup
    fi

    echo "==> switch to ${branch}"
    git checkout --quiet -B "${branch}" "origin/${branch}" \
        || { echo "upgrade: ${branch} changes a file you edited; nothing was changed (README, \"Local changes\")" >&2; exit 1; }

    local rc=0
    bin/esystem-upgrade "${src}" || rc=$?
    if [ "${rc}" -eq 3 ]; then
        echo "==> back to ${old}: the site was not changed" >&2
        git checkout --quiet -B "${old}" "${old_commit}"
    fi
    exit "${rc}"
}

main "$@"
