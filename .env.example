# Copy to .env and edit. docker compose reads .env from this directory.
# Recreate the affected containers after a change: docker compose up -d

# Prefix of the container, network and image-build names.
COMPOSE_PROJECT_NAME=esystem

# --- Web -------------------------------------------------------------------

# Space-separated host names users reach the site on. The first one MUST
# equal PRIMARY_DOMAIN; it names the certificate directory, certs/live/<it>/.
PRIMARY_DOMAIN=esystem.example.org
DOMAINS="esystem.example.org"

# Address and ports nginx publishes on. 0.0.0.0 = every interface. HTTPS is
# published on tcp and udp (HTTP/3). HTTP_PORT must stay 80 when certbot is
# enabled (Let's Encrypt HTTP-01).
HOST_IP=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# --- Certificates ----------------------------------------------------------
# Default: you install the certificate (README, "Certificates"). Uncomment to
# have certbot obtain and renew one from Let's Encrypt instead; every name in
# DOMAINS must then resolve publicly to this server and reach it on port 80.
#COMPOSE_PROFILES=letsencrypt
#LE_EMAIL=it@example.org
# 1 = Let's Encrypt staging (untrusted certificates, no rate limits) for a
# first test run.
#LE_STAGING=0

# --- Application -----------------------------------------------------------

# IANA timezone of the esystem and delivery containers. Users see times in
# it and scheduled work runs by it.
TZ=Europe/London

# SEB installers served from /delivery/api/secure/download. Defaults to the
# copy shipped in the build; set to a directory of your own to replace them.
#DOWNLOAD_DIR=./seb

# Memory ceilings of the app containers.
#ESYSTEM_MEMORY=5g
#DELIVERY_MEMORY=2g

# --- Database --------------------------------------------------------------
# Defaults suit a database of a few GB. Recreate db after a change:
#   docker compose up -d db
#
#   size    when                                shared_buffers  DB_MEMORY
#   small   default                             256MB           2g
#   medium  database of several GB              1GB             3g
#   large   database over ~10GB, heavy reports  2GB             6g
#
# DB_MEMORY is a ceiling and must hold shared_buffers plus page cache plus
# query memory. Rules of thumb: shared_buffers <= DB_MEMORY / 3,
# effective_cache_size ~ DB_MEMORY - 1GB.

#DB_MAX_CONNECTIONS=220

# small (the defaults)
#DB_SHARED_BUFFERS=256MB
#DB_EFFECTIVE_CACHE_SIZE=1GB
#DB_WORK_MEM=8MB
#DB_MAINTENANCE_WORK_MEM=128MB
#DB_MEMORY=2g

# medium
#DB_SHARED_BUFFERS=1GB
#DB_EFFECTIVE_CACHE_SIZE=2GB
#DB_WORK_MEM=16MB
#DB_MAINTENANCE_WORK_MEM=128MB
#DB_MEMORY=3g

# large
#DB_SHARED_BUFFERS=2GB
#DB_EFFECTIVE_CACHE_SIZE=5GB
#DB_WORK_MEM=64MB
#DB_MAINTENANCE_WORK_MEM=512MB
#DB_MEMORY=6g

# Log every work_mem spill of at least this size (kB) and every statement
# slower than this (ms). -1 = off.
#DB_LOG_TEMP_FILES=-1
#DB_LOG_MIN_DURATION=-1
